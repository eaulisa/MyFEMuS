# Fieldsplit
-level-1ksp_richardson_scale 1.0

-level-1ksp_rtol 1.e-8
-level-1ksp_atol 1.e-12
-level-1ksp_divtol 1.e+50
-level-1ksp_max_it 1
-level-1ksp_norm_type none

-level-1pc_fieldsplit_schur_fact_type upper
-level-1pc_fieldsplit_schur_precondition selfp

# Velocity
-level-1fieldsplit_0_pc_hmg_reuse_interpolation true
-level-1fieldsplit_0_pc_hmg_use_subspace_coarsening false
-level-1fieldsplit_0_pc_hmg_use_matmaij false
-level-1fieldsplit_0_pc_hmg_coarsening_component 0
-level-1fieldsplit_0_hmg_inner_pc_type gamg
-level-1fieldsplit_0_hmg_inner_pc_gamg_aggressive_square_graph false

-level-1fieldsplit_0_mg_levels_ksp_type chebyshev
-level-1fieldsplit_0_mg_levels_ksp_max_it 1
-level-1fieldsplit_0_mg_levels_ksp_norm_type none
-level-1fieldsplit_0_mg_levels_pc_type jacobi

-level-2fieldsplit_0_pc_hmg_reuse_interpolation true
-level-2fieldsplit_0_pc_hmg_use_subspace_coarsening false
-level-2fieldsplit_0_pc_hmg_use_matmaij false
-level-2fieldsplit_0_pc_hmg_coarsening_component 0
-level-2fieldsplit_0_hmg_inner_pc_type gamg
-level-2fieldsplit_0_hmg_inner_pc_gamg_aggressive_square_graph false

-level-2fieldsplit_0_mg_levels_ksp_type chebyshev
-level-2fieldsplit_0_mg_levels_ksp_max_it 1
-level-2fieldsplit_0_mg_levels_ksp_norm_type none
-level-2fieldsplit_0_mg_levels_pc_type jacobi


# Pressure
-level-1fieldsplit_1_pc_hmg_reuse_interpolation true
-level-1fieldsplit_1_pc_hmg_use_subspace_coarsening false
-level-1fieldsplit_1_pc_hmg_use_matmaij false
-level-1fieldsplit_1_pc_hmg_coarsening_component 0
-level-1fieldsplit_1_hmg_inner_pc_type gamg
-level-1fieldsplit_1_hmg_inner_pc_gamg_aggressive_square_graph false

-level-1fieldsplit_1_mg_levels_ksp_type chebyshev
-level-1fieldsplit_1_mg_levels_ksp_max_it 2
-level-1fieldsplit_1_mg_levels_ksp_norm_type none
-level-1fieldsplit_1_mg_levels_pc_type sor
-level-1fieldsplit_1_mg_levels_pc_sor_local_symmetric

set(FEMUS_ALGOIM_SOURCE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}")

function(femus_enable_algoim target_name)
  if(NOT TARGET "${target_name}")
    message(FATAL_ERROR "Algoim requires an existing FEMuS application target")
  endif()
  if(NOT TARGET femus_algoim)
    find_path(FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY NAMES lapacke.h mkl_lapacke.h)
    find_library(FEMUS_ALGOIM_LAPACKE_LIBRARY NAMES lapacke mkl_rt)
    if(NOT FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY OR NOT FEMUS_ALGOIM_LAPACKE_LIBRARY)
      message(FATAL_ERROR "Algoim needs LAPACKE headers and a LAPACKE library; install liblapacke-dev or set FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY and FEMUS_ALGOIM_LAPACKE_LIBRARY")
    endif()
    add_library(femus_algoim STATIC "${FEMUS_ALGOIM_SOURCE_DIRECTORY}/FemusAlgoim.cpp")
    target_compile_features(femus_algoim PRIVATE cxx_std_17)
    set_target_properties(femus_algoim PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_EXTENSIONS OFF)
    target_include_directories(femus_algoim PRIVATE "${FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY}")
    target_include_directories(femus_algoim PUBLIC "${FEMUS_ALGOIM_SOURCE_DIRECTORY}")
    target_link_libraries(femus_algoim PUBLIC "${FEMUS_ALGOIM_LAPACKE_LIBRARY}" ${FEMUS_ALGOIM_EXTRA_LIBRARIES})
  endif()
  target_link_libraries("${target_name}" femus_algoim)
endfunction()

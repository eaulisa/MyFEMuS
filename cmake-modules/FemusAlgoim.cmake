include_guard(GLOBAL)

if(NOT TARGET femus_algoim)
  if(NOT TARGET Eigen3::Eigen)
    find_package(Eigen3 REQUIRED NO_MODULE)
  endif()
  find_path(FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY NAMES lapacke.h mkl_lapacke.h)
  find_library(FEMUS_ALGOIM_LAPACKE_LIBRARY NAMES lapacke mkl_rt)
  if(NOT FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY OR NOT FEMUS_ALGOIM_LAPACKE_LIBRARY)
    message(FATAL_ERROR "Algoim needs LAPACKE headers and a LAPACKE library; set FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY and FEMUS_ALGOIM_LAPACKE_LIBRARY")
  endif()
  add_library(femus_algoim INTERFACE)
  target_compile_features(femus_algoim INTERFACE cxx_std_17)
  target_include_directories(femus_algoim INTERFACE "${CMAKE_CURRENT_LIST_DIR}/../src/quadrature" "${FEMUS_ALGOIM_LAPACKE_INCLUDE_DIRECTORY}")
  target_link_libraries(femus_algoim INTERFACE Eigen3::Eigen "${FEMUS_ALGOIM_LAPACKE_LIBRARY}" ${FEMUS_ALGOIM_EXTRA_LIBRARIES})
endif()

function(femus_enable_algoim target_name)
  if(NOT TARGET "${target_name}")
    message(FATAL_ERROR "Algoim requires an existing FEMuS application target")
  endif()
  target_link_libraries("${target_name}" femus_algoim)
endfunction()
